<% if @libro.errors.any? %>
  <div class="alert alert-danger">
    <p class="fw-semibold mb-2">
      No se pudo guardar el libro:
    </p>

    <ul class="mb-0">
      <% @libro.errors.full_messages.each do |mensaje| %>
        <li><%= mensaje %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @libro do |form| %>

  <div class="row g-3">

    <div class="col-12">
      <%= form.label :titulo,
            "Título",
            class: "form-label" %>

      <%= form.text_field :titulo,
            class: "form-control",
            required: true,
            autofocus: true,
            placeholder: "Título del libro" %>
    </div>

    <div class="col-12">
      <%= form.label :autor,
            "Autor",
            class: "form-label" %>

      <%= form.text_field :autor,
            class: "form-control",
            required: true,
            placeholder: "Nombre del autor" %>
    </div>

    <div class="col-12 col-md-6">
      <%= form.label :isbn,
            "ISBN",
            class: "form-label" %>

      <%= form.text_field :isbn,
            class: "form-control",
            placeholder: "Ej. 9781234567890" %>
    </div>

    <div class="col-12 col-md-6">
      <%= form.label :categoria_id,
            "Categoría",
            class: "form-label" %>

      <%= form.collection_select :categoria_id,
            @categorias,
            :id,
            :nombre,
            { prompt: "Selecciona una categoría" },
            {
              class: "form-select",
              required: true
            } %>
    </div>

    <div class="col-12 col-md-6">
      <%= form.label :editorial,
            "Editorial",
            class: "form-label" %>

      <%= form.text_field :editorial,
            class: "form-control",
            placeholder: "Editorial" %>
    </div>

    <div class="col-12 col-md-6">
      <%= form.label :idioma,
            "Idioma",
            class: "form-label" %>

      <%= form.text_field :idioma,
            class: "form-control",
            placeholder: "Ej. Español" %>
    </div>

    <div class="col-12 col-md-4">
      <%= form.label :anio_publicacion,
            "Año de publicación original",
            class: "form-label" %>

      <%= form.number_field :anio_publicacion,
            class: "form-control",
            min: 0,
            placeholder: "Ej. 1949" %>
    </div>

    <div class="col-12 col-md-4">
      <%= form.label :anio_edicion,
            "Año de esta edición",
            class: "form-label" %>

      <%= form.number_field :anio_edicion,
            class: "form-control",
            min: 0,
            placeholder: "Ej. 2024" %>
    </div>

    <div class="col-12 col-md-4">
      <%= form.label :unidades,
            "Ejemplares",
            class: "form-label" %>

      <%= form.number_field :unidades,
            class: "form-control",
            min: 0,
            required: true %>
    </div>

  </div>

  <hr class="my-4">

  <div class="d-flex justify-content-end gap-2">
    <%= link_to "Cancelar",
          @libro.persisted? ? libro_path(@libro) : libros_path,
          class: "btn btn-outline-secondary" %>

    <%= form.submit @libro.persisted? ? "Guardar cambios" : "Agregar libro",
          class: "btn btn-dark px-4" %>
  </div>

<% end %>