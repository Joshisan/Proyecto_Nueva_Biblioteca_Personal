<div class="login-page registration-page">
  <div class="login-shell registration-shell">

    <section class="login-showcase registration-showcase">
      <div class="login-showcase-content">

        <div class="login-brand">
          <div class="login-brand-icon">
            <i class="bi bi-book"></i>
          </div>

          <div>
            <strong>Biblioteca</strong>
            <span>Personal</span>
          </div>
        </div>

        <div class="login-showcase-copy registration-showcase-copy">
          <span class="login-eyebrow">ÚNETE A LA BIBLIOTECA</span>

          <h1>
            Tu próxima<br>
            lectura comienza aquí.
          </h1>

          <p>
            Crea tu cuenta para acceder al catálogo, registrar tus lecturas
            y llevar un seguimiento personal de tu progreso.
          </p>
        </div>

        <div class="registration-steps">

          <div class="registration-step">
            <span class="registration-step-number">1</span>

            <div>
              <strong>Solicita tu acceso</strong>
              <span>Completa tus datos personales</span>
            </div>
          </div>

          <div class="registration-step">
            <span class="registration-step-number">2</span>

            <div>
              <strong>Espera la aprobación</strong>
              <span>Un administrador revisará tu solicitud</span>
            </div>
          </div>

          <div class="registration-step">
            <span class="registration-step-number">3</span>

            <div>
              <strong>Comienza a leer</strong>
              <span>Accede al catálogo y registra tu progreso</span>
            </div>
          </div>

        </div>

      </div>

      <div class="login-decoration login-decoration-one"></div>
      <div class="login-decoration login-decoration-two"></div>
      <div class="login-decoration login-decoration-three"></div>
    </section>

    <section class="login-access registration-access">
      <div class="login-form-container registration-form-container">

        <div class="login-mobile-brand">
          <div class="login-brand-icon">
            <i class="bi bi-book"></i>
          </div>

          <div>
            <strong>Biblioteca</strong>
            <span>Personal</span>
          </div>
        </div>

        <div class="login-heading registration-heading">
          <span class="login-eyebrow login-eyebrow-dark">
            NUEVA CUENTA
          </span>

          <h2>Solicitar acceso</h2>

          <p>
            Completa tus datos, un administrador deberá aprobar
            tu cuenta antes de que puedas iniciar sesión
          </p>
        </div>

        <% if @usuario.errors.any? %>
          <div class="registration-errors">
            <div class="registration-errors-icon">
              <i class="bi bi-exclamation-circle"></i>
            </div>

            <div>
              <strong>No pudimos registrar tu solicitud</strong>

              <ul>
                <% @usuario.errors.full_messages.each do |mensaje| %>
                  <li><%= mensaje %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <%= form_with model: @usuario,
              url: registro_path,
              class: "login-form registration-form" do |form| %>

          <div class="registration-name-grid">

            <div class="login-field">
              <%= form.label :nombre,
                    "Nombre",
                    class: "login-label" %>

              <div class="login-input-wrapper">
                <i class="bi bi-person login-input-icon"></i>

                <%= form.text_field :nombre,
                      required: true,
                      autofocus: true,
                      autocomplete: "given-name",
                      placeholder: "Tu nombre",
                      class: "form-control login-input" %>
              </div>
            </div>

            <div class="login-field">
              <%= form.label :apellido,
                    "Apellido",
                    class: "login-label" %>

              <div class="login-input-wrapper">
                <i class="bi bi-person login-input-icon"></i>

                <%= form.text_field :apellido,
                      required: true,
                      autocomplete: "family-name",
                      placeholder: "Tu apellido",
                      class: "form-control login-input" %>
              </div>
            </div>

          </div>

          <div class="login-field">
            <%= form.label :email,
                  "Correo electrónico",
                  class: "login-label" %>

            <div class="login-input-wrapper">
              <i class="bi bi-envelope login-input-icon"></i>

              <%= form.email_field :email,
                    required: true,
                    autocomplete: "email",
                    placeholder: "nombre@correo.com",
                    class: "form-control login-input" %>
            </div>
          </div>

          <div class="login-field">
            <%= form.label :password,
                  "Contraseña",
                  class: "login-label" %>

            <div class="input-group login-password"
                 data-controller="password-visibility">

              <span class="login-password-icon">
                <i class="bi bi-lock"></i>
              </span>

              <%= form.password_field :password,
                    required: true,
                    minlength: 8,
                    autocomplete: "new-password",
                    placeholder: "Mínimo 8 caracteres",
                    class: "form-control login-input login-password-input",
                    data: {
                      password_visibility_target: "input"
                    } %>

              <button type="button"
                      class="login-password-toggle"
                      data-action="password-visibility#toggle"
                      aria-label="Mostrar contraseña"
                      title="Mostrar u ocultar contraseña">

                <i class="bi bi-eye"
                   data-password-visibility-target="icon"></i>
              </button>

            </div>
          </div>

          <div class="login-field">
            <%= form.label :password_confirmation,
                  "Confirmar contraseña",
                  class: "login-label" %>

            <div class="input-group login-password"
                 data-controller="password-visibility">

              <span class="login-password-icon">
                <i class="bi bi-shield-lock"></i>
              </span>

              <%= form.password_field :password_confirmation,
                    required: true,
                    minlength: 8,
                    autocomplete: "new-password",
                    placeholder: "Repite tu contraseña",
                    class: "form-control login-input login-password-input",
                    data: {
                      password_visibility_target: "input"
                    } %>

              <button type="button"
                      class="login-password-toggle"
                      data-action="password-visibility#toggle"
                      aria-label="Mostrar contraseña"
                      title="Mostrar u ocultar contraseña">

                <i class="bi bi-eye"
                   data-password-visibility-target="icon"></i>
              </button>

            </div>
          </div>

          <div class="registration-approval-note">
            <i class="bi bi-info-circle"></i>

            <span>
              Tu cuenta permanecerá pendiente hasta que
              un administrador apruebe tu solicitud
            </span>
          </div>

          <div class="d-grid login-submit-wrapper registration-submit-wrapper">
            <%= form.submit "Solicitar acceso",
                  class: "btn login-submit" %>
          </div>

        <% end %>

        <div class="login-register registration-login">
          <span>¿Ya tienes una cuenta?</span>

          <%= link_to login_path do %>
            Iniciar sesión
            <i class="bi bi-arrow-right"></i>
          <% end %>
        </div>

      </div>
    </section>

  </div>
</div>